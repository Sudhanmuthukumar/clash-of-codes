# Database Connection (Neon Free PostgreSQL in production / Local PostgreSQL in development)
# Production format: postgresql://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Server Port (Render sets process.env.PORT automatically)
PORT=5000

# Security & Authentication Secrets (Use strong random strings in production)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
ADMIN_USER_ID=admin
ADMIN_PASSWORD=replace-with-strong-production-admin-password

# CORS Configuration (Set to your deployed Vercel domain in production)
FRONTEND_URL=https://your-clash-of-codes.vercel.app

# Node Environment ('development' or 'production')
NODE_ENV=production
